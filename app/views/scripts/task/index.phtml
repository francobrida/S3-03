    </div>

     <div class="taskContainer p-4 bg-indigo-500 max-w-2xl self-center rounded-xl shadow-lg ">
        <?php 
        $displayTasks = $this->view->tasks ?? $this->tasks ?? [];
        
        if (empty($displayTasks)): 
            echo "<p>No hay tareas disponibles.</p>";
        else:
            foreach ($displayTasks as $task): ?>
                <div class="taskItem border p-4 mb-4 bg-gray-300 rounded-xl shadow display: grid grid-cols-5 gap-4">
                    <div class=""><h2 class="text-xl font-bold"><?php echo htmlspecialchars($task['name']); ?></h2></div>
                    <div class=""><p><?php echo htmlspecialchars($task['description']); ?></p></div>
                    <div class=""><p class="text-sm text-gray-500">Estado: <?php echo htmlspecialchars($task['state']);  ?></p></div>
                    <div class=""><p class="text-sm text-gray-800">Fecha creación: <?php echo htmlspecialchars($task['creation_date']); ?></p></div>

                </div>
             <?php endforeach; ?>
        <?php endif; ?>
     </div>
</body>

