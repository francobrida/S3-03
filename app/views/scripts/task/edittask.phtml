                <input class="bg-gray-200 pl-2 rounded" type="text" name="name" value="<?= htmlspecialchars($this->task['name']); ?>" maxlength="20">
                <textarea class="bg-gray-200 pl-2 rounded resize-none text-justify align-middle" type="text" name="description" maxlength="100"><?= htmlspecialchars($this->task['description']); ?></textarea>
                
                <select name="category_id">
                    <?php foreach ($this->categories as $cat): ?>
                        <option value="<?= $cat['id'] ?>"
