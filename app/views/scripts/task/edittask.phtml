        <form action="<?php echo WEB_ROOT; ?>/task/updateTask" method="POST">
            <div class="taskItem p-4 pb-0 mb-4  display: grid grid-cols-5 gap-4">
                <div class="flex justify-center">Nombre</div>
                <div class="flex justify-center">Descripción</div>
