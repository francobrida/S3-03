        Agregar nuevo usuario
    </a>
</div>

<div style="margin-bottom: 20px;">
    <input type="text" id="userSearch" placeholder="Buscar por nickname, nombre, email..." 
           style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;">
</div>

<script>
document.getElementById('userSearch').addEventListener('keyup', function() {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll('table tbody tr');

    rows.forEach(row => {
        // Obtenemos el texto de toda la fila (nickname, nombre, apellido, email)
        let text = row.textContent.toLowerCase();
        
        // El equivalente a strpos() en JS es .includes()
        if (text.includes(filter)) {
            row.style.display = ""; // Muestra la fila
        } else {
            row.style.display = "none"; // Oculta la fila
        }
    });
});
</script>

<table border="1" width="100%">
    <thead>
        <tr>
            <th>Nickname</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        <?php 
        $users = isset($this->_data['users']) ? $this->_data['users'] : []; 
        ?>
        <?php foreach ($users as $user): ?>
            <tr>
                <td><?php echo isset($user['nickname']) ? $user['nickname'] : ''; ?></td>
                <td><?php echo isset($user['name']) ? $user['name'] : ''; ?></td>
                <td><?php echo isset($user['surname']) ? $user['surname'] : ''; ?></td>
                <td><?php echo isset($user['email']) ? $user['email'] : ''; ?></td>
                <td><?php echo isset($user['type']) ? $user['type'] : ''; ?></td>
                <td>
                    <?php 
                    $userId = isset($user['id']) ? $user['id'] : ''; 
                    $urlEdit = WEB_ROOT . "/user/edit?id=" . $userId;
                    ?>
                    <a href="<?php echo $urlEdit; ?>" 
                        <button type="button">Editar</button>
                    </a>

                    <?php 
                    $userId = isset($user['id']) ? $user['id'] : ''; 
                    $urlDelete = WEB_ROOT . "/user/delete?id=" . $userId;
                    ?>
                    <a href="<?php echo $urlDelete; ?>" 
                       onclick="return confirm('Confirmar eliminar usuario con sus respectivas tareas');">
                        <button type="button">Eliminar</button>
                    </a>
                </td>
            </tr>
        <?php endforeach; ?>
    </tbody>
</table>