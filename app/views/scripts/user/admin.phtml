    <tbody>
        <?php 
        $users = isset($this->_data['users']) ? $this->_data['users'] : []; 
        ?>
        <?php foreach ($users as $user): ?>
            <tr>
                <td><?php echo isset($user['nickname']) ? $user['nickname'] : ''; ?></td>
                <td><?php echo isset($user['name']) ? $user['name'] : ''; ?></td>
                <td><?php echo isset($user['surname']) ? $user['surname'] : ''; ?></td>
                <td><?php echo isset($user['email']) ? $user['email'] : ''; ?></td>
                <td><?php echo isset($user['type']) ? $user['type'] : ''; ?></td>
                <td>
                    <?php 
                    $userId = isset($user['id']) ? $user['id'] : ''; 
                    $urlEdit = WEB_ROOT . "/user/edit?id=" . $userId;
                    ?>
                    <a href="<?php echo $urlEdit; ?>" 
                        <button type="button">Editar</button>
                    </a>

                    <?php 
                    $userId = isset($user['id']) ? $user['id'] : ''; 
                    $urlDelete = WEB_ROOT . "/user/delete?id=" . $userId;
                    ?>
                    <a href="<?php echo $urlDelete; ?>" 
                       onclick="return confirm('Confirm delete user');">
                        <button type="button">Eliminar</button>
                    </a>
                </td>
            </tr>
        <?php endforeach; ?>
    </tbody>
</table>